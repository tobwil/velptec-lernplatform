    {
      "parameters": {
        "jsCode": "// Speichert Score-Karten in den statischen Workflow-Daten (nur im aktiven Produktivbetrieb persistent).\nconst data = $getWorkflowStaticData('global');\ndata.cards = data.cards || {};\nconst card = $input.first().json.body || {};\nconst valid = typeof card.id === 'string' && typeof card.name === 'string' && card.name.length <= 40 && Number.isFinite(card.xp) && Number.isFinite(card.updated);\nif (valid) {\n  const prev = data.cards[card.id];\n  if (!prev || prev.updated < card.updated) data.cards[card.id] = card;\n}\nreturn [{ json: { cards: Object.values(data.cards) } }];"
      },
      "id": "a1c0f6a8-0003-4c55-9d2e-000000000003",
      "name": "Karte speichern",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\nreturn [{ json: { cards: Object.values(data.cards || {}) } }];"
      },
